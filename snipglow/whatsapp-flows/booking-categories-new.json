{
  "version": "6.0",
  "data_api_version": "3.0",
  "routing_model": {
    "CATEGORY_SCREEN": ["BOOKING_SCREEN"],
    "BOOKING_SCREEN": []
  },
  "screens": [
    {
      "id": "CATEGORY_SCREEN",
      "title": "Book Appointment",
      "data": {
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "Hair", "title": "Hair" },
            { "id": "Skin", "title": "Skin" }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "category_form",
            "children": [
              {
                "type": "Dropdown",
                "name": "category",
                "label": "Select Category",
                "data-source": "${data.categories}",
                "required": true
              },
              {
                "type": "Footer",
                "label": "Next",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "category": "${form.category}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "BOOKING_SCREEN",
      "title": "Your Details & Services",
      "terminal": true,
      "success": true,
      "data": {
        "category": { "type": "string", "__example__": "Hair" },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "svc1", "title": "Haircut - Rs.200" }
          ]
        },
        "dates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "2026-05-22", "title": "Thu, 22 May" }
          ]
        },
        "time_slots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "10:00:00", "title": "10:00 AM" }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "booking_form",
            "children": [
              {
                "type": "TextInput",
                "name": "customer_name",
                "label": "Your Name",
                "input-type": "text",
                "required": true
              },
              {
                "type": "Dropdown",
                "name": "gender",
                "label": "Gender",
                "data-source": [
                  { "id": "male", "title": "Male" },
                  { "id": "female", "title": "Female" },
                  { "id": "other", "title": "Other" }
                ],
                "required": false
              },
              {
                "type": "CheckboxGroup",
                "name": "service_ids",
                "label": "Select Services",
                "data-source": "${data.services}",
                "required": true
              },
              {
                "type": "Dropdown",
                "name": "date",
                "label": "Select Date",
                "data-source": "${data.dates}",
                "required": true
              },
              {
                "type": "Dropdown",
                "name": "time_slot",
                "label": "Select Time",
                "data-source": "${data.time_slots}",
                "required": true
              },
              {
                "type": "Footer",
                "label": "Confirm Booking",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "customer_name": "${form.customer_name}",
                    "gender": "${form.gender}",
                    "service_ids": "${form.service_ids}",
                    "date": "${form.date}",
                    "time_slot": "${form.time_slot}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
